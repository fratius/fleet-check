{
  "expo": {
    "name": "Fratius",
    "slug": "fleet-check",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "fratius",
      "fleetcheck"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fratius.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Fratius uses the camera to photograph and film vans for walk-arounds, handovers and damage checks.",
        "NSPhotoLibraryUsageDescription": "Fratius opens your photos so you can check van pictures you already took.",
        "NSMicrophoneUsageDescription": "Fratius films vans for handovers and damage checks. The videos are recorded without sound.",
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E2FF1C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fratius.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Fratius",
      "themeColor": "#000000",
      "backgroundColor": "#ECEEF1"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ECEEF1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#111316"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fratius uses the camera to photograph and film vans for walk-arounds, handovers and damage checks.",
          "recordAudioAndroid": false,
          "microphonePermission": "Fratius films vans for handovers and damage checks. The videos are recorded without sound."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fratius opens your photos so you can check van pictures you already took.",
          "cameraPermission": "Fratius uses the camera to photograph and film vans for walk-arounds, handovers and damage checks.",
          "microphonePermission": "Fratius films vans for handovers and damage checks. The videos are recorded without sound."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E2FF1C",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyCWD8rNoaOyYtHCRhfBO-1AgbhdZVEdAPY",
        "authDomain": "fleet-check-2aa34.firebaseapp.com",
        "projectId": "fleet-check-2aa34",
        "storageBucket": "fleet-check-2aa34.firebasestorage.app",
        "messagingSenderId": "812447072608",
