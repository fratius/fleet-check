{
  "expo": {
    "name": "Fleet Check",
    "slug": "fleet-check",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fleetcheck",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fleetcheck.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Fleet Check uses the camera to photograph vehicles for walk-arounds and damage checks.",
        "NSPhotoLibraryUsageDescription": "Fleet Check opens your photos so you can check vehicle pictures you already took."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E2FF1C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fleetcheck.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Fleet Check",
      "themeColor": "#000000",
      "backgroundColor": "#ECEEF1"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": { "web": false }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ECEEF1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#111316"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fleet Check uses the camera to photograph vehicles for walk-arounds and damage checks.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fleet Check opens your photos so you can check vehicle pictures you already took.",
          "cameraPermission": "Fleet Check uses the camera to photograph vehicles for walk-arounds and damage checks.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyCWD8rNoaOyYtHCRhfBO-1AgbhdZVEdAPY",
        "authDomain": "fleet-check-2aa34.firebaseapp.com",
        "projectId": "fleet-check-2aa34",
        "storageBucket": "fleet-check-2aa34.firebasestorage.app",
        "messagingSenderId": "812447072608",
        "appId": "1:812447072608:web:afa74b20ad53c093c09e05"
      },
      "eas": {
        "projectId": "a73c29a2-b492-4320-822e-fb6dabc2ab99"
      }
    },
    "owner": "fratius-org",
    "updates": {
      "url": "https://u.expo.dev/a73c29a2-b492-4320-822e-fb6dabc2ab99"
    }
  }
}
