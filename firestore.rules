rules_version = '2';

// Who can do what
//   App creator  sign-in claim `creator`, set by the Deploy workflow from the APP_CREATOR_EMAILS variable.
//                Reads and changes every company. Can view the app as an owner, manager or driver of one company
//                (users/{uid}.viewAs, set in the Account tab): then the rules treat them exactly as that role, and
//                their app creator access is off until they switch back.
//   Owner        member role "owner" (or "admin", its older name). Everything in the company.
//   Manager      member role "manager". Vans, walk-arounds, checks and drivers of their stations; approves damage.
//   Driver       member role "driver". Reads the vans of their stations and saves walk-arounds.
// History (who had which van, walk-arounds, damage checks) is never deleted.
// Type scans and damage checks are written by the server (Cloud Functions). Managers add the review.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function creatorClaim() { return signedIn() && request.auth.token.get('creator', false) == true; }
    // "View as": only with the app creator claim; for anyone else the field means nothing. It only ever takes
    // access away (the creator can do everything anyway), so the creator sets it on their own profile.
    function userPath() { return /databases/$(database)/documents/users/$(me()); }
    function viewing() { return creatorClaim() && exists(userPath()) && get(userPath()).data.get('viewAs', null) != null; }
    function va() { return get(userPath()).data.viewAs; }
    function viewingIn(orgId) { return viewing() && va().org == orgId; }
    function creator() { return creatorClaim() && !viewing(); }
    function memberPath(orgId) { return /databases/$(database)/documents/orgs/$(orgId)/members/$(me()); }
    // A real member of the company (not while viewing as someone).
    function realMember(orgId) { return signedIn() && !viewing() && exists(memberPath(orgId)); }
    function member(orgId) { return signedIn() && (viewingIn(orgId) || realMember(orgId)); }
    function m(orgId) { return get(memberPath(orgId)).data; }
    function owner(orgId) { return creator() || (viewingIn(orgId) && va().role == 'owner') || (realMember(orgId) && m(orgId).role in ['owner', 'admin']); }
    function manager(orgId) { return (viewingIn(orgId) && va().role == 'manager') || (realMember(orgId) && m(orgId).role == 'manager'); }
    function staff(orgId) { return owner(orgId) || manager(orgId); }
    // Works at this station (managers and drivers; owners pass before this is asked).
    function inStation(orgId, stationId) {
      // Written as "in [station]" like a member's list, so queries with where('stationId', 'in', ...) pass too.
      return (viewingIn(orgId) && va().get('st', null) is string && stationId in [va().st])
        || (realMember(orgId) && stationId in m(orgId).get('stationIds', []));
    }
    // A person's record (members) shares a station with the one asking (managers; owners pass before).
    function sharesStation(orgId) {
      return (viewingIn(orgId) && va().get('st', null) is string && resource.data.get('stationIds', []).hasAny([va().st]))
        || (realMember(orgId) && resource.data.get('stationIds', []).hasAny(m(orgId).get('stationIds', [])));
    }
    // Can see or work on things at this station? Owners and the creator pass before the station is read,
    // so records saved before stations existed stay visible to them.
    function at(orgId, stationId) { return owner(orgId) || (member(orgId) && inStation(orgId, stationId)); }
    // Manager of this station, or owner?
    function runs(orgId, stationId) { return owner(orgId) || (manager(orgId) && inStation(orgId, stationId)); }

    // Which companies a person belongs to, and which one they had open. viewAs: only the app creator sets it,
    // as {org, role: owner | manager | driver, st: station (managers and drivers)}, or null to be themselves.
    function okViewAs(d) {
      return !('viewAs' in d) || d.viewAs == null
        || (creatorClaim() && d.viewAs is map && d.viewAs.keys().hasOnly(['org', 'role', 'st']) && d.viewAs.org is string
          && (d.viewAs.role == 'owner' || ((d.viewAs.role == 'manager' || d.viewAs.role == 'driver') && d.viewAs.get('st', null) is string)));
    }
    // The app's language: a short code ("de", "pt"), or null to follow the phone. The server writes notifications in it.
    function okLang(d) {
      return (!('lang' in d) || d.lang == null || (d.lang is string && d.lang.matches('[a-z]{2,3}')))
        && (!('appLang' in d) || d.appLang == null || (d.appLang is string && d.appLang.matches('[a-z]{2,3}')));
    }
    // pendingJoin (the driver sign-up a person waits for) and signedUpAs (came in through a driver link) are written by
    // the server only.
    match /users/{uid} {
      allow read: if (signedIn() && uid == me()) || creator();
      allow create: if signedIn() && uid == me() && okViewAs(request.resource.data) && okLang(request.resource.data)
        && !('pendingJoin' in request.resource.data) && !('signedUpAs' in request.resource.data);
      allow update: if signedIn() && uid == me() && okViewAs(request.resource.data) && okLang(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pendingJoin', 'signedUpAs']);
      allow delete: if signedIn() && uid == me();
    }

    // The phones where a person turned notifications on: one record each, kept by the person. The server sends to
    // them (notify in the functions) and forgets the ones the push service says are gone. The web app saves the
    // browser's push address; the App Store and Google Play app its Expo push token.
    function webPush(d) {
      return d.keys().hasOnly(['endpoint', 'keys', 'createdAt', 'device'])
        && d.endpoint is string && d.endpoint.size() < 1000
        && d.endpoint.matches('https://([a-z0-9-]+[.])*(fcm[.]googleapis[.]com|push[.]apple[.]com|push[.]services[.]mozilla[.]com|notify[.]windows[.]com)/.*')
        && d.keys.keys().hasOnly(['p256dh', 'auth'])
        && d.keys.p256dh is string && d.keys.p256dh.size() < 200
        && d.keys.auth is string && d.keys.auth.size() < 100;
    }
    function appPush(d) {
      return d.keys().hasOnly(['expo', 'platform', 'createdAt', 'device'])
        && d.expo is string && d.expo.size() < 250 && d.expo.matches('Expo(nent)?PushToken.[A-Za-z0-9_-]{10,200}.')
        && d.platform in ['ios', 'android']
        && (!('device' in d) || (d.device is string && d.device.size() < 200));
    }
    match /users/{uid}/push/{id} {
      allow read, delete: if signedIn() && uid == me();
      allow create, update: if signedIn() && uid == me() && (webPush(request.resource.data) || appPush(request.resource.data));
    }

    // Settings the app reads (written by the Deploy workflow): the public key for phone notifications.
    match /config/{doc} {
      allow read: if signedIn();
    }
    // Whether payments are on and Stripe's publishable key (public by design): the sign-up page reads it signed out.
    match /config/payments {
      allow read: if true;
    }

    // Who the app creators are, and how payments are set up (written by the Deploy workflow; no secrets).
    match /platform/{doc} {
      allow read: if creator();
    }
    function paymentsLive() {
      let p = /databases/$(database)/documents/platform/stripe;
      return exists(p) && get(p).data.get('mode', null) == 'live';
    }

    // Sign-up links the app creator makes for one DSP (saveOffer): trial days, a discount, a fixed plan. Server only;
    // the creator lists them in the Account tab. payments/{org} (Stripe's ids), stripeEvents and fakeStripe (the
    // tests' Stripe) have no rules: nobody reads or writes them from the app.
    match /offers/{code} {
      allow read: if creator();
      match /uses/{orgId} {
        allow read: if creator();
      }
    }

    // Invite links: made and used only by the server (createInvite, acceptInvite), one person each,
    // valid for 24 hours. The app makes them for fleet managers; drivers sign up with the company's link
    // (joinRequests below). Owners and managers see the links of their company and can cancel them.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if staff(resource.data.orgId);
      allow delete: if owner(resource.data.orgId)
        || (resource.data.role == 'driver' && runs(resource.data.orgId, resource.data.stationId));
    }

    // The company's driver link (driverLink, requestToJoin): which company a link is for and whether it still works.
    // Server only; nobody reads or writes it from the app (the join page asks peekInvite).
    match /companyLinks/{token} {
      allow read, write: if false;
    }

    // What only the server writes on a company: the free trial and plan (billing), the accepted terms, the demo marks,
    // and the vans in use (fleetSize, counted by the server for the plan's limit).
    // closed / reopens: a company whose only member deleted their account, and the app creator reopening it.
    function serverOrgKeys() { return ['billing', 'terms', 'demo', 'demoLogins', 'fleetSize', 'closed', 'reopens']; }
    // Nothing is written in a closed company, by anyone (read-only until the app creator reopens it on the server).
    function notClosed(orgId) { return get(/databases/$(database)/documents/orgs/$(orgId)).data.get('closed', null) == null; }
    // Numbers that can't be right (functions/src/numbers.ts and src/lib/numbers.ts hold the same rule).
    function pos(d, k) { return !(k in d) || d[k] == null || (d[k] is number && d[k] > 0); }
    function nonNeg(d, k) { return !(k in d) || d[k] == null || (d[k] is number && d[k] >= 0); }
    function okVanNums(d) {
      return pos(d, 'tankL') && pos(d, 'batteryKwh') && pos(d, 'rangeKm') && nonNeg(d, 'keys') && nonNeg(d, 'powerKw')
        && nonNeg(d, 'heightM') && nonNeg(d, 'lengthM') && nonNeg(d, 'grossKg') && nonNeg(d, 'emptyKg') && nonNeg(d, 'payloadKg') && nonNeg(d, 'cargoM3')
        && (!('modelYear' in d) || d.modelYear == null || (d.modelYear is int && d.modelYear >= 1950 && d.modelYear <= request.time.year() + 1));
    }
    function okDetailNums(d) {
      return pos(d, 'odometerKm') && pos(d, 'kmAtStart') && pos(d, 'kmPerYear') && (!('due' in d) || d.due == null || pos(d.due, 'serviceKm'));
    }
    function okCostNums(d) {
      return nonNeg(d, 'monthly') && nonNeg(d, 'purchasePrice') && nonNeg(d, 'excessPerKm') && nonNeg(d, 'premium') && nonNeg(d, 'deductible');
    }
    // The van's km never go down from the app (blind test, 26 Nov 2026, cause 2b): a lower odometer than the record's or
    // the van's last dashboard photo is refused; an owner or the station's manager corrects too-high km on the server
    // (correctKm), with a reason.
    function kmNotDown(orgId, id) {
      let odo = request.resource.data.get('odometerKm', null);
      let van = get(/databases/$(database)/documents/orgs/$(orgId)/vehicles/$(id)).data;
      return odo == null
        || (resource != null && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['odometerKm']))
        || ((resource == null || odo >= resource.data.get('odometerKm', 0))
          && (van.get('dash', null) == null || odo >= van.dash.get('km', 0)));
    }
    // Room for another van on the company's plan (billing.vans; null or missing: no limit).
    function vanRoom(orgId) {
      let o = get(/databases/$(database)/documents/orgs/$(orgId)).data;
      let max = o.get('billing', {}).get('vans', null);
      return max == null || o.get('fleetSize', 0) < max;
    }
    match /orgs/{orgId} {
      allow get: if member(orgId) || creator();
      allow list: if creator();
      // New companies are made by the server (createCompany). Older apps still make them here: without the server's
      // fields, and with a creation time of now (the trial counts from it, functions/src/billing.ts); not once payments
      // are live, since then every new company adds a card first.
      // Only the app creator picks the company's AI model (aiTier; product owner, 2026-11-02) and switches the automatic
      // damage comparison on or off (aiCompare; product owner, 2026-11-20).
      allow create: if signedIn() && request.resource.data.createdBy == me() && !paymentsLive()
        && !request.resource.data.keys().hasAny(serverOrgKeys())
        && request.resource.data.createdAt is int && math.abs(request.resource.data.createdAt - request.time.toMillis()) < 600000
        && (creator() || !request.resource.data.keys().hasAny(['aiTier', 'aiCompare']));
      allow update: if notClosed(orgId) && owner(orgId) && request.resource.data.createdBy == resource.data.createdBy
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOrgKeys().concat(['createdAt']))
        && (creator() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aiTier', 'aiCompare']))
        && (!('aiCompare' in request.resource.data) || request.resource.data.aiCompare is bool);
      // Companies aren't deleted from the app (demo companies are removed by the server).

      match /stations/{stationId} {
        allow read: if member(orgId) || creator();
        // Owners add, rename and remove stations. Whether drivers pick up and drop off vans themselves
        // (selfAssign) is set on the server (setSelfAssign), which records who changed it and when.
        allow create: if notClosed(orgId) && owner(orgId) && !request.resource.data.keys().hasAny(['selfAssign', 'selfAssignBy', 'selfAssignAt']);
        allow update: if notClosed(orgId) && owner(orgId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'code']);
        allow delete: if notClosed(orgId) && owner(orgId);
      }

      // The company's current driver link, for owners and fleet managers to share. Made by the server (driverLink);
      // only owners make a new one.
      match /links/{id} {
        allow read: if staff(orgId);
      }

      // Km corrections (correctKm, server only): old km, new km, who and why, for good. Owners and the station's managers.
      match /kmCorrections/{id} {
        allow read: if runs(orgId, resource.data.stationId);
      }

      // Drivers who signed up with the company's link and wait for approval (one record per person, written by the
      // server: requestToJoin, decideJoinRequest). Owners and the fleet managers of the station they picked read
      // them and decide; the person reads their own. They aren't members until approved, so they see nothing else.
      match /joinRequests/{uid} {
        allow read: if (signedIn() && uid == me()) || runs(orgId, resource.data.stationId);
      }

      // The names of the company's people, kept by the server (functions/src/names.ts) so owners and fleet managers
      // see who had a van or did a check, also for people who left. Drivers never see another driver's name: they
      // read only their own here, and the records they read (vans, damage checks, their own history) keep only
      // account ids where someone else did something. Nobody writes them from the app.
      match /names/{uid} {
        allow read: if staff(orgId) || (member(orgId) && uid == me());
      }

      match /members/{uid} {
        // Owners see everyone; a fleet manager only the people of their own stations (product owner, 22 Nov 2026:
        // another station's drivers and their phone, email and Transporter ID stay hidden). A person who left (no
        // record any more) reads as gone, not refused. Lists by managers ask where('stationIds', 'array-contains-any',
        // their stations) (watchMembers in src/lib/people.ts).
        allow get: if (signedIn() && uid == me()) || owner(orgId)
          || (manager(orgId) && (resource == null || sharesStation(orgId)));
        allow list: if owner(orgId) || (manager(orgId) && sharesStation(orgId));
        // The person who created the company becomes its first owner.
        allow create: if notClosed(orgId) && signedIn() && uid == me() && request.resource.data.role == 'owner'
          && get(/databases/$(database)/documents/orgs/$(orgId)).data.createdBy == me();
        // People join through invite links or, for drivers, the company's link once approved (the server adds them).
        // Roles, stations and removals go through the
        // server too (changePerson, removePerson): it ends the person's van assignment so the history stays right.
        // Everyone keeps their own contact details up to date.
        allow update: if notClosed(orgId) && signedIn() && uid == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'firstName', 'lastName', 'phone', 'transporterId']);
      }

      // Vans are never deleted (their history must stay): they are retired by the server (retireVan).
      // Who drives a van (assignedTo), retiring and moving between stations are done by the server too.
      // Drivers see only the van they have (product owner, 2026-11-26; blind test, cause 3a): the station's other vans,
      // their walk-arounds and checks are for owners and the station's managers. A driver picks up a van by its plate
      // (the server's vanByPlate), and reads the walk-arounds they took and the checks of their own photos.
      function heldByMe(orgId, vehicleId) {
        return get(/databases/$(database)/documents/orgs/$(orgId)/vehicles/$(vehicleId)).data.get('assignedTo', null) != null
          && get(/databases/$(database)/documents/orgs/$(orgId)/vehicles/$(vehicleId)).data.assignedTo.driverId == me();
      }
      match /vehicles/{id} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && resource.data.assignedTo.driverId == me());
        // Who has it (assignedTo, with their km), its latest dashboard (dash: km, levels, warning lights) and its
        // checks for drivers (todo: due now; routines: when each was last done) and its next garage visit drivers may
        // see (garageVisit, from the service appointments) are the server's.
        // Not beyond the vans of the company's plan: then the owner takes the add-on or the next plan (Plan and billing).
        allow create: if notClosed(orgId) && runs(orgId, request.resource.data.stationId)
          && !request.resource.data.keys().hasAny(['assignedTo', 'retired', 'retiredAt', 'retiredBy', 'dash', 'todo', 'routines', 'garageVisit', 'kmLower'])
          && okVanNums(request.resource.data)
          && (creator() || vanRoom(orgId));
        allow update: if notClosed(orgId) && runs(orgId, resource.data.stationId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stationId', 'assignedTo', 'retired', 'retiredAt', 'retiredBy', 'dash', 'todo', 'routines', 'garageVisit', 'kmLower'])
          && okVanNums(request.resource.data);
      }

      // The business side of a van (doc id = the van's id): contract, insurance, deadlines, odometer, notes.
      // Owners and the van's station managers only; drivers never read it. It carries the van's station so a
      // manager can query theirs, and must match the van's (the server keeps it in step when a van moves).
      // Money is not allowed in here: it goes in vehicleCosts, which only owners read.
      match /vehicleDetails/{id} {
        allow read: if runs(orgId, resource.data.stationId);
        allow create, update: if notClosed(orgId) && runs(orgId, request.resource.data.stationId)
          && request.resource.data.stationId == get(/databases/$(database)/documents/orgs/$(orgId)/vehicles/$(id)).data.get('stationId', null)
          && !request.resource.data.keys().hasAny(['monthly', 'purchasePrice', 'excessPerKm', 'premium', 'deductible'])
          && request.resource.data.keys().size() <= 40
          && okDetailNums(request.resource.data) && kmNotDown(orgId, id);
        // Kept with the van for good, like its history.
      }

      // What a van costs (doc id = the van's id): monthly rate, purchase price, price per extra kilometre,
      // insurance premium and deductible. Owners only.
      match /vehicleCosts/{id} {
        allow read: if owner(orgId);
        allow create, update: if notClosed(orgId) && owner(orgId)
          && exists(/databases/$(database)/documents/orgs/$(orgId)/vehicles/$(id))
          && request.resource.data.keys().hasOnly(['createdAt', 'updatedAt', 'updatedByName', 'monthly', 'purchasePrice', 'excessPerKm', 'premium', 'deductible'])
          && okCostNums(request.resource.data);
      }

      // A fleet file read for adding the whole fleet at once (readFleetFile, addVans): the vans as read, with their
      // costs where an owner read it. Server only, kept a day; the app gets the reading in the call's answer.
      match /imports/{rest=**} {
        allow read, write: if false;
      }

      // A driver's record (doc id = their account): licence, employment, briefings, emergency contact, notes.
      // Owners and the managers of the driver's station keep it; the driver reads their own. Its station is the
      // driver's (the server moves it with them). Licence checks are added only by the server and never changed.
      match /driverRecords/{uid} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && uid == me());
        allow create: if notClosed(orgId) && runs(orgId, request.resource.data.stationId)
          && request.resource.data.stationId in get(/databases/$(database)/documents/orgs/$(orgId)/members/$(uid)).data.get('stationIds', [])
          && !('checks' in request.resource.data)
          && request.resource.data.keys().size() <= 30;
        allow update: if notClosed(orgId) && runs(orgId, resource.data.stationId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['checks', 'stationId'])
          && request.resource.data.keys().size() <= 30;
        // Kept when the driver leaves (the van history keeps their name too).
      }

      // Accidents, traffic fines, customer complaints and other incidents of a driver. Owners and the station's
      // managers add and correct them; the driver reads their own. Nobody deletes them.
      match /incidents/{id} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && resource.data.driverId == me());
        allow create: if notClosed(orgId) && runs(orgId, request.resource.data.stationId)
          && request.resource.data.keys().hasOnly(['driverId', 'driverName', 'vehicleId', 'vehicleName', 'stationId', 'day', 'time', 'kind', 'fineType', 'atFault', 'note', 'by', 'byName', 'createdAt'])
          && request.resource.data.by == me()
          && request.resource.data.driverId is string && request.resource.data.driverId.size() > 0
          && request.resource.data.kind in ['accident', 'fine', 'complaint', 'other']
          && request.resource.data.day is string && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.note is string && request.resource.data.note.size() <= 2000
          && request.resource.data.createdAt is int && math.abs(request.resource.data.createdAt - request.time.toMillis()) < 600000;
        allow update: if notClosed(orgId) && runs(orgId, resource.data.stationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverId', 'driverName', 'vehicleId', 'vehicleName', 'day', 'time', 'kind', 'fineType', 'atFault', 'note', 'updatedAt', 'updatedByName'])
          && request.resource.data.kind in ['accident', 'fine', 'complaint', 'other']
          && request.resource.data.note is string && request.resource.data.note.size() <= 2000;
      }

      // Tours (a dashboard photo at the start and one at the end) and the dashboard readings themselves: written
      // only by the server, which reads the photos and works out the kilometres and fuel. Owners and the station's
      // managers read them; drivers their own.
      match /tours/{id} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && resource.data.driverId == me());
      }
      match /readings/{id} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && (resource.data.driverId == me() || resource.data.by == me()));
      }
      // What the AI read before the person confirmed it, with its speed and cost: the app creator only.
      match /dashReads/{id} {
        allow read: if creator();
      }
      // Documents read from a photo (what kind, how many details, speed and cost; never the values): the app creator only.
      match /docReads/{id} {
        allow read: if creator();
      }

      // Refuelling, washing and parts bought for a van: every attempt, finished, refused or given up. Written only by
      // the server (the purchase function checks the fuel card and reads the receipt), never edited or deleted.
      // Owners and the station's managers read them (they allow or refuse a wrong card there); the person who
      // bought something reads their own.
      match /purchases/{id} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && resource.data.by == me());
      }
      // Checks for drivers (the oil level, the cargo area…): everyone in the company sees what's asked; owners and
      // fleet managers set them through the server (the routine function), which checks the station.
      match /routines/{id} {
        allow read: if member(orgId) || creator();
      }
      // Each check done (fine, or a problem with a note): written by the server, never changed. The station's
      // fleet managers and owners read them; drivers the ones they did.
      match /routineDone/{id} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && resource.data.by == me());
      }
      // The service history of each van (services, tyres, brakes, repairs, the TÜV) with km and costs: written only
      // by the server (the service function), never deleted; a correction keeps what was there before. Owners and
      // the van's station managers read it (it moves with the van); drivers don't. The TÜV reminders already sent
      // (serviceNags) are the server's only: no rule lets anyone in.
      match /services/{id} {
        allow read: if runs(orgId, resource.data.stationId);
      }
      // Service appointments at the garage (booked, moved, cancelled, done): written only by the server (the
      // appointment function; done when the service is filled in from it), never deleted. Owners and the van's
      // station managers read them; drivers don't.
      match /serviceAppointments/{id} {
        allow read: if runs(orgId, resource.data.stationId);
      }
      // What the AI read from the dashboard, the card and the receipt, with its speed and cost: the app creator only.
      match /buyReads/{id} {
        allow read: if creator();
      }

      // New damage found by a reviewed check and who had the van in that time (written by the server from the
      // review), for the drivers' numbers. Owners and the station's managers read it; drivers the ones they're in.
      match /damageLog/{id} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && me() in resource.data.driverIds);
      }

      // Who had which van, when. Written only by the server (assignVan and friends), never edited or deleted:
      // this is the permanent history of every van and every driver. Owners and managers of the station read
      // it; drivers read their own.
      match /assignments/{id} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && resource.data.driverId == me());
      }

      match /walkarounds/{id} {
        allow read: if runs(orgId, resource.data.stationId)
          || (member(orgId) && (resource.data.createdBy == me() || heldByMe(orgId, resource.data.vehicleId)));
        allow create: if notClosed(orgId) && at(orgId, request.resource.data.stationId)
          && (request.resource.data.createdBy == me() || creator())
          && !request.resource.data.keys().hasAny(['handover', 'keepMark', 'keepDamage', 'keepUntil', 'mediaDeletedAt', 'cmp']);
        // No edits or deletes: walk-arounds are part of the van's and the driver's history. Only the server marks
        // one as the photos of a pick-up or drop-off (handover), keeps the photos 90 days when they show damage
        // (keepMark, keepDamage, keepUntil: markDamage and the review), says when they were deleted
        // (mediaDeletedAt: the monthly clean-up, functions/src/media.ts) and writes how the automatic damage
        // comparison with the van's earlier photos went (cmp: compareOnWalk).
      }

      // A finished damage review reopened ("Change the review"): back to waiting, with who reopened it and when added to
      // the earlier ones; nothing else changes in the same step.
      function reopened() {
        let before = resource.data.get('reopens', []);
        let after = request.resource.data.get('reopens', []);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reopens'])
          && request.resource.data.status == 'submitted'
          && after is list && after.size() == before.size() + 1
          && (before.size() == 0 || after[0:before.size()] == before)
          && after[before.size()].keys().hasOnly(['by', 'byName', 'at'])
          && after[before.size()].by == me()
          && after[before.size()].at is number
          && after[before.size()].get('byName', '') is string;
      }
      match /checks/{id} {
        allow read: if runs(orgId, resource.data.stationId)
          || (member(orgId) && (resource.data.get('walkBy', null) == me() || resource.data.get('createdBy', null) == me() || heldByMe(orgId, resource.data.vehicleId)));
        // Only the review (and the status it sets) can be written from the app, and only by a manager of the station.
        // A finished review is locked (blind test, 26 Nov 2026, cause 2): nothing changes until someone reopens it
        // ("Change the review"), which only sets it back to waiting and adds who reopened it and when to `reopens`.
        allow update: if notClosed(orgId) && runs(orgId, resource.data.stationId)
          && ((resource.data.get('status', '') == 'reviewed' && reopened())
            || (resource.data.get('status', '') != 'reviewed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review', 'status', 'reviewedAt'])));
        // No deletes: damage checks are part of the van's and the driver's history.
      }

      // Videos of vans: at pick-up, at drop-off, or a walk-around any time. Written only by the server, which
      // checks them. The station's owners and managers watch them; drivers see the ones they recorded.
      match /videos/{id} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && resource.data.by == me());
      }

      // Comments on a van's damage. Owners and the station's managers read and add them; nobody edits or deletes
      // them, so what was said about a damage stays with it.
      match /damageNotes/{id} {
        allow read: if runs(orgId, resource.data.stationId);
        allow create: if notClosed(orgId) && runs(orgId, request.resource.data.stationId)
          && request.resource.data.keys().hasOnly(['vehicleId', 'stationId', 'damageKey', 'text', 'by', 'byName', 'createdAt'])
          && request.resource.data.by == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.damageKey is string && request.resource.data.damageKey.size() <= 200
          && request.resource.data.createdAt is int && math.abs(request.resource.data.createdAt - request.time.toMillis()) < 600000
          && get(/databases/$(database)/documents/orgs/$(orgId)/vehicles/$(request.resource.data.vehicleId)).data.stationId == request.resource.data.stationId;
      }

      // AI speed and cost of each damage check (written by the server). Only the app creator sees them.
      match /checkUsage/{id} {
        allow read: if creator();
      }

      // The automatic damage comparison of each walk-around (functions/src/compare.ts): what the AI said about every
      // frame, time and cost. Written by the server; only the app creator reads it (the test log). Owners and
      // managers see the summary on the walk-around and the damage check it made.
      match /compares/{id} {
        allow read: if creator();
      }

      // Type scans (which body class): they carry AI speed and cost and feed the test log, so only the app creator
      // reads them. Owners and managers still tell whether the AI was right when they add a van.
      match /scans/{id} {
        allow read: if creator();
        allow update: if notClosed(orgId) && staff(orgId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verdict', 'actual']);
      }
    }
  }
}
