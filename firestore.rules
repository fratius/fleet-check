rules_version = '2';

// Who can do what
//   App creator  sign-in claim `creator`, set by the Deploy workflow from the APP_CREATOR_EMAILS variable.
//                Reads and changes every company. Can view the app as an owner, manager or driver of one company
//                (users/{uid}.viewAs, set in the Account tab): then the rules treat them exactly as that role, and
//                their app creator access is off until they switch back.
//   Owner        member role "owner" (or "admin", its older name). Everything in the company.
//   Manager      member role "manager". Vans, walk-arounds, checks and drivers of their stations; approves damage.
//   Driver       member role "driver". Reads the vans of their stations and saves walk-arounds.
// History (who had which van, walk-arounds, damage checks) is never deleted.
// Type scans and damage checks are written by the server (Cloud Functions). Managers add the review.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function creatorClaim() { return signedIn() && request.auth.token.get('creator', false) == true; }
    // "View as": only with the app creator claim; for anyone else the field means nothing. It only ever takes
    // access away (the creator can do everything anyway), so the creator sets it on their own profile.
    function userPath() { return /databases/$(database)/documents/users/$(me()); }
    function viewing() { return creatorClaim() && exists(userPath()) && get(userPath()).data.get('viewAs', null) != null; }
    function va() { return get(userPath()).data.viewAs; }
    function viewingIn(orgId) { return viewing() && va().org == orgId; }
    function creator() { return creatorClaim() && !viewing(); }
    function memberPath(orgId) { return /databases/$(database)/documents/orgs/$(orgId)/members/$(me()); }
    // A real member of the company (not while viewing as someone).
    function realMember(orgId) { return signedIn() && !viewing() && exists(memberPath(orgId)); }
    function member(orgId) { return signedIn() && (viewingIn(orgId) || realMember(orgId)); }
    function m(orgId) { return get(memberPath(orgId)).data; }
    function owner(orgId) { return creator() || (viewingIn(orgId) && va().role == 'owner') || (realMember(orgId) && m(orgId).role in ['owner', 'admin']); }
    function manager(orgId) { return (viewingIn(orgId) && va().role == 'manager') || (realMember(orgId) && m(orgId).role == 'manager'); }
    function staff(orgId) { return owner(orgId) || manager(orgId); }
    // Works at this station (managers and drivers; owners pass before this is asked).
    function inStation(orgId, stationId) {
      // Written as "in [station]" like a member's list, so queries with where('stationId', 'in', ...) pass too.
      return (viewingIn(orgId) && va().get('st', null) is string && stationId in [va().st])
        || (realMember(orgId) && stationId in m(orgId).get('stationIds', []));
    }
    // Can see or work on things at this station? Owners and the creator pass before the station is read,
    // so records saved before stations existed stay visible to them.
    function at(orgId, stationId) { return owner(orgId) || (member(orgId) && inStation(orgId, stationId)); }
    // Manager of this station, or owner?
    function runs(orgId, stationId) { return owner(orgId) || (manager(orgId) && inStation(orgId, stationId)); }

    // Which companies a person belongs to, and which one they had open. viewAs: only the app creator sets it,
    // as {org, role: owner | manager | driver, st: station (managers and drivers)}, or null to be themselves.
    function okViewAs(d) {
      return !('viewAs' in d) || d.viewAs == null
        || (creatorClaim() && d.viewAs is map && d.viewAs.keys().hasOnly(['org', 'role', 'st']) && d.viewAs.org is string
          && (d.viewAs.role == 'owner' || ((d.viewAs.role == 'manager' || d.viewAs.role == 'driver') && d.viewAs.get('st', null) is string)));
    }
    match /users/{uid} {
      allow read: if (signedIn() && uid == me()) || creator();
      allow create, update: if signedIn() && uid == me() && okViewAs(request.resource.data);
      allow delete: if signedIn() && uid == me();
    }

    // Who the app creators are (written by the Deploy workflow).
    match /platform/{doc} {
      allow read: if creator();
    }

    // Invite links: made and used only by the server (createInvite, acceptInvite), one person each,
    // valid for 24 hours. Owners and managers see the links of their company and can cancel them.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if staff(resource.data.orgId);
      allow delete: if owner(resource.data.orgId)
        || (resource.data.role == 'driver' && runs(resource.data.orgId, resource.data.stationId));
    }

    match /orgs/{orgId} {
      allow get: if member(orgId) || creator();
      allow list: if creator();
      allow create: if signedIn() && request.resource.data.createdBy == me();
      allow update: if owner(orgId) && request.resource.data.createdBy == resource.data.createdBy;
      // Companies aren't deleted from the app (demo companies are removed by the server).

      match /stations/{stationId} {
        allow read: if member(orgId) || creator();
        // Owners add, rename and remove stations. Whether drivers pick up and drop off vans themselves
        // (selfAssign) is set on the server (setSelfAssign), which records who changed it and when.
        allow create: if owner(orgId) && !request.resource.data.keys().hasAny(['selfAssign', 'selfAssignBy', 'selfAssignAt']);
        allow update: if owner(orgId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'code']);
        allow delete: if owner(orgId);
      }

      match /members/{uid} {
        allow get: if (signedIn() && uid == me()) || staff(orgId);
        allow list: if staff(orgId);
        // The person who created the company becomes its first owner.
        allow create: if signedIn() && uid == me() && request.resource.data.role == 'owner'
          && get(/databases/$(database)/documents/orgs/$(orgId)).data.createdBy == me();
        // People join through invite links (the server adds them). Roles, stations and removals go through the
        // server too (changePerson, removePerson): it ends the person's van assignment so the history stays right.
        // Everyone keeps their own contact details up to date.
        allow update: if signedIn() && uid == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'firstName', 'lastName', 'phone', 'transporterId']);
      }

      // Vans are never deleted (their history must stay): they are retired by the server (retireVan).
      // Who drives a van (assignedTo), retiring and moving between stations are done by the server too.
      match /vehicles/{id} {
        allow read: if at(orgId, resource.data.stationId);
        allow create: if runs(orgId, request.resource.data.stationId)
          && !request.resource.data.keys().hasAny(['assignedTo', 'retired', 'retiredAt', 'retiredBy']);
        allow update: if runs(orgId, resource.data.stationId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stationId', 'assignedTo', 'retired', 'retiredAt', 'retiredBy']);
      }

      // Who had which van, when. Written only by the server (assignVan and friends), never edited or deleted:
      // this is the permanent history of every van and every driver. Owners and managers of the station read
      // it; drivers read their own.
      match /assignments/{id} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && resource.data.driverId == me());
      }

      match /walkarounds/{id} {
        allow read: if at(orgId, resource.data.stationId);
        allow create: if at(orgId, request.resource.data.stationId)
          && (request.resource.data.createdBy == me() || creator())
          && !request.resource.data.keys().hasAny(['handover']);
        // No edits or deletes: walk-arounds are part of the van's and the driver's history. Only the server marks
        // one as the photos of a pick-up or drop-off (handover).
      }

      match /checks/{id} {
        allow read: if at(orgId, resource.data.stationId);
        // Only the review (and the status it sets) can be written from the app, and only by a manager of the station.
        allow update: if runs(orgId, resource.data.stationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review', 'status', 'reviewedAt']);
        // No deletes: damage checks are part of the van's and the driver's history.
      }

      // Videos of vans: at pick-up, at drop-off, or a walk-around any time. Written only by the server, which
      // checks them. The station's owners and managers watch them; drivers see the ones they recorded.
      match /videos/{id} {
        allow read: if runs(orgId, resource.data.stationId) || (member(orgId) && resource.data.by == me());
      }

      // Comments on a van's damage. Owners and the station's managers read and add them; nobody edits or deletes
      // them, so what was said about a damage stays with it.
      match /damageNotes/{id} {
        allow read: if runs(orgId, resource.data.stationId);
        allow create: if runs(orgId, request.resource.data.stationId)
          && request.resource.data.keys().hasOnly(['vehicleId', 'stationId', 'damageKey', 'text', 'by', 'byName', 'createdAt'])
          && request.resource.data.by == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.damageKey is string && request.resource.data.damageKey.size() <= 200
          && request.resource.data.createdAt is int && math.abs(request.resource.data.createdAt - request.time.toMillis()) < 600000
          && get(/databases/$(database)/documents/orgs/$(orgId)/vehicles/$(request.resource.data.vehicleId)).data.stationId == request.resource.data.stationId;
      }

      match /scans/{id} {
        allow read: if staff(orgId);
        allow update: if staff(orgId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verdict', 'actual']);
      }
    }
  }
}
