  "id": "w230",
  "key": "Good to know",
  "where": "page"
 },
 {
  "id": "w231",
  "key": "Does Fratius replace the DVIC?",
  "where": "page"
 },
 {
  "id": "w232",
  "key": "No. The DVIC stays in Amazon's tools. Fratius covers your own vans between drivers: handovers with proof, damage, fuel, deadlines and paperwork.",
  "where": "page"
 },
 {
  "id": "w233",
  "key": "What counts as a station?",
  "where": "page"
 },
 {
  "id": "w234",
  "key": "A place your vans run from. Each station has its own managers, drivers and vans. Owners see all stations; managers and drivers see their own.",
  "where": "page"
 },
 {
  "id": "w235",
  "key": "Do drivers need an iPhone?",
  "where": "page"
 },
 {
  "id": "w236",
  "key": "No. Fratius runs on iPhone, Android and as a web app in any phone's browser.",
  "where": "page"
 },
 {
  "id": "w237",
  "key": "Can anything in the history be changed?",
  "where": "page"
 },
 {
  "id": "w238",
  "key": "No. Handovers are written by the server and never edited or deleted. Vans are retired instead of deleted, and people who leave keep their history.",
  "where": "page"
 },
 {
  "id": "w239",
  "key": "What do you keep about drivers?",
  "where": "page"
 },
 {
  "id": "w240",
  "key": "Licence classes and expiry, licence checks, briefings and incidents. Never licence numbers or copies, birth dates, home addresses or health data.",
  "where": "page"
 },
 {
  "id": "w241",
  "key": "How long do you keep photos and videos?",
  "where": "page"
 },
 {
  "id": "w242",
  "key": "Until the 15th of the month after: on the 15th, the photos and videos of the month before are deleted. Never while the van is still with the driver who had it: those wait until the van is given back. Photos and videos marked as damage are kept 90 days. The records of who had which van, and when, are kept for good.",
  "where": "page"
 },
 {
  "id": "w243",
  "key": "What about damage found at the end of a lease?",
  "where": "page"
 },
 {
  "id": "w244",
  "key": "Every damage found is on the van's record with the date and who had the van. Its photos are kept 90 days, so settle it with the driver or the insurer in that time.",
  "where": "page"
 },
 {
  "id": "w245",
  "key": "How do people join?",
  "where": "page"
 },
 {
  "id": "w246",
  "key": "By invite link: one person, one use, valid for 24 hours. Owners invite managers and drivers; managers invite drivers to their own station.",
  "where": "page"
 },
 {
  "id": "w247",
  "key": "Handovers, damage and van history for delivery partners who run their own vans.",
  "where": "page"
 },
 {
  "id": "w248",
  "key": "Fratius is an independent product. It is not affiliated with, endorsed by or sponsored by Amazon.",
  "where": "page"
 },
 {
